{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "types": ["node"],

    /* Bundler mode */
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Alias */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"],
  "exclude": [
    "src/features/profile/components/dialogs/access-token-dialog.tsx",
    "src/features/profile/components/dialogs/change-password-dialog.tsx",
    "src/features/profile/components/dialogs/delete-account-dialog.tsx",
    "src/features/profile/components/dialogs/email-bind-dialog.tsx",
    "src/features/profile/components/dialogs/two-fa-backup-dialog.tsx",
    "src/features/profile/components/dialogs/two-fa-disable-dialog.tsx",
    "src/features/profile/components/dialogs/wechat-bind-dialog.tsx",
    "src/features/profile/components/profile-security-card.tsx",
    "src/features/profile/components/tabs/account-bindings-tab.tsx",
    "src/features/profile/hooks/use-access-token.ts"
  ]
}
